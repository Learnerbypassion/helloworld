# ============================================================
# MediKiosk -- Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
# ============================================================

# --- Node API ---
PORT=8000
NODE_ENV=development
JWT_SECRET=medikiosk-dev-secret-change-me-in-production

# --- MongoDB ---
# Local:  mongodb://localhost:27017/medikiosk
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/medikiosk
MONGO_URI=mongodb://localhost:27017/medikiosk

# --- PaddleOCR Sidecar ---
# Dev:            http://127.0.0.1:8001  (default)
# Docker Compose: http://ocr:8001        (overridden in docker-compose.yml)
OCR_SERVICE_URL=http://127.0.0.1:8001
OCR_TIMEOUT_MS=30000

# --- AI Clinical Summary (Ollama) ---
# Install: https://ollama.com/download
# Pull:    ollama pull llama3.1:8b
# If absent, summaries are skipped gracefully (summary=null)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_MS=60000

# --- Twilio OTP & Queue Calling Agent ---
# Shared Twilio Account SID & Auth Token (used for both OTP and Voice/SMS Calling Agent)
# If absent, runs in graceful DEMO/LOG-ONLY mode with masked phone numbers.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# 1. Twilio Verify (OTP Service)
TWILIO_VERIFY_SID=your_twilio_verify_service_sid

# 2. Twilio Programmable Voice & SMS (Queue Calling Agent)
# E.164 format from-number: e.g. +12025550192 or +91XXXXXXXXXX
TWILIO_FROM_NUMBER=+12025550192

# --- Indic Voice & Language Engine (Sarvam AI / Bhashini) ---
SARVAM_API_KEY=
# Bhashini (Government of India)
BHASINI_INFERENCE_KEY=your_inference_api_key
BHASINI_UDYAT_KEY=your_udyat_ulca_api_key
BHASINI_USER_ID=your_bhashini_user_id_or_email

# --- Mock Central ABHA Platform URL ---
ABHA_SERVER_URL=http://localhost:8005
